{
  "name": "venfork",
  "version": "0.10.0",
  "description": "Create and manage private mirrors for vendor development",
  "type": "module",
  "bin": {
    "venfork": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node",
    "compile": "bun build ./src/index.ts --compile --outfile ./dist/venfork",
    "dev": "bun run ./src/index.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test ./tests/unit",
    "test:integration": "bun test --timeout 30000 ./tests/integration",
    "test:watch": "bun test --watch ./tests/unit",
    "test:coverage": "bun test --coverage ./tests/unit && bun test --coverage --timeout 30000 ./tests/integration",
    "test:e2e": "VENFORK_E2E=1 bun test ./tests/e2e --timeout 900000",
    "test:e2e:dispatch": "VENFORK_E2E=1 VENFORK_E2E_REAL_DISPATCH=1 bun test ./tests/e2e --timeout 900000",
    "setup": "bun install && bun run build",
    "link": "bun link",
    "unlink": "bun unlink",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check --write ."
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "git",
    "github",
    "mirror",
    "fork",
    "vendor",
    "contractor"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cabljac/venfork.git"
  },
  "bugs": {
    "url": "https://github.com/cabljac/venfork/issues"
  },
  "homepage": "https://github.com/cabljac/venfork#readme",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "execa": "^9.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "^18.19.0 || >=20.5.0"
  }
}
